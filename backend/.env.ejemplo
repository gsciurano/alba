# Plantilla. Para usarla:
#
#   cp .env.ejemplo .env
#
# y poner la clave real de MySQL en el .env (ese archivo esta en el
# .gitignore y nunca se sube a GitHub). Este .ejemplo no lleva ninguna
# clave de verdad: solo muestra que variables hacen falta.
#
# Solo hace falta si se usa el DEPURADOR de VS Code. Para el uso normal
# alcanza con tener DB_PASSWORD en el ~/.zshrc, que es lo que ya esta
# configurado.

DB_USER=root
DB_PASSWORD=escribi-aca-tu-clave-de-mysql
