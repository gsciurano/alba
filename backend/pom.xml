<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot como padre: administra las versiones de todas las dependencias -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.albaenlosandes</groupId>
    <artifactId>gestor-inventario</artifactId>
    <version>1.0.0</version>
    <name>Gestor de Inventario - Alba en los Andes</name>
    <description>Backend Spring Boot para gestion de inventario y e-commerce de la bodega</description>

    <properties>
        <java.version>26</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web: controladores REST, servidor embebido (Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: repositorios, Hibernate, ORM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Thymeleaf: motor de plantillas del lado del servidor.

            Desde esta etapa el sitio web ya no se sirve aparte con
            'python3 -m http.server': lo sirve este mismo Spring Boot en el
            puerto 8080, renderizando HTML a partir de las plantillas de
            src/main/resources/templates/.

            Spring Boot lo autoconfigura solo: prefijo classpath:/templates/,
            sufijo .html, codificacion UTF-8. No hace falta ningun XML.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            Spring Security: sesion de servidor y proteccion de rutas.

            QUE RESUELVE, Y POR QUE SE SUMA AHORA. Hasta esta etapa el
            servidor contestaba quien era cada persona y se olvidaba al
            instante: el rol quedaba guardado en el navegador y los
            endpoints de administracion estaban abiertos a cualquiera.

            Con una sesion de verdad el servidor sabe quien pide cada
            pagina, y entonces puede decidir QUE BOTONES EXISTEN en el
            HTML que devuelve, en vez de dibujarlos y esconderlos. Esa es
            la base del modelo de hipermedia que usa el resto de la
            migracion.

            OJO CON /api/**: esos endpoints los consume tambien la
            aplicacion de escritorio en Swing (paquete 'escritorio'), que
            no es un navegador y no tiene sesion ni token CSRF. Quedan
            explicitamente abiertos en SecurityConfig, igual que estaban
            antes; la diferencia es que ahora esta escrito y a la vista.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!-- Bean Validation: valida los datos que entran por la API (@NotBlank, @Positive...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Envio de correo (JavaMail): el comprobante de compra al cliente -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
            MERCADO PAGO. El SDK oficial, que es un cliente HTTP con los
            objetos de la API ya escritos (preferencias, pagos, busquedas).

            POR QUE EL SDK Y NO fetch A MANO: la firma de los pedidos, los
            reintentos, el idempotency-key y la forma exacta de cada
            respuesta los mantiene Mercado Pago. Escribirlo a mano es
            mantener su API en este repositorio.

            La version esta clavada a proposito: una version "latest"
            cambia el comportamiento del cobro sin que nadie lo haya
            decidido, y esto mueve plata.
        -->
        <dependency>
            <groupId>com.mercadopago</groupId>
            <artifactId>sdk-java</artifactId>
            <version>3.7.0</version>
        </dependency>

        <!-- Driver de MySQL (solo se necesita en tiempo de ejecucion) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            ============================================================
             DE DONDE SALE LO QUE VA ADENTRO DEL JAR
            ============================================================
            El frontend NO vive adentro del backend: vive en la carpeta
            frontend/ de la raiz del repositorio, al lado de backend/.
            Son dos cosas distintas y se ven como dos cosas distintas.

            Pero Spring sirve las plantillas y los archivos estaticos
            DESDE EL CLASSPATH (ver application.properties), asi que al
            compilar hay que copiarlos adentro. Eso es lo que hace el
            segundo <resource> de aca: toma ../frontend y lo deja en el
            jar bajo la carpeta 'frontend', que es exactamente donde
            estaba antes. Por eso la configuracion de Spring no cambio.

            CONSECUENCIA PRACTICA: un cambio en una plantilla o en el
            CSS se ve despues de volver a arrancar (./arrancar.sh), que
            es lo que ya habia que hacer con los cambios de Java.

            El primer <resource> es el de siempre: lo que de verdad es
            del backend (application.properties y datos/).
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../frontend</directory>
                <targetPath>frontend</targetPath>
                <excludes>
                    <!-- Documentacion: se lee en el repositorio, no hace falta en el jar. -->
                    <exclude>README.md</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
