{
  // ============================================================
  //  ARRANQUE DEL BACKEND DESDE VS CODE
  //
  //  Hay un solo arranque a proposito. VS Code suele agregar solo una
  //  entrada automatica con "mainClass" sin el paquete (por ejemplo
  //  "GestorInventarioApplication" en vez de
  //  "com.albaenlosandes.inventario.GestorInventarioApplication"), y esa
  //  falla con "Main class not found". Si vuelve a aparecer una entrada
  //  asi, se puede borrar: la de abajo es la buena.
  //
  //  LA CLAVE DE MYSQL: este arranque NO pasa por la terminal, asi que no
  //  lee el ~/.zshrc. Para que la encuentre hay que crear el archivo
  //  backend/.env (esta en el .gitignore, nunca se sube) con esta linea:
  //
  //      DB_PASSWORD=tu-clave-de-mysql
  //
  //  Si la clave no llega, la aplicacion ARRANCA igual pero todos los
  //  endpoints responden error 500 por "Access denied" de MySQL. Es un
  //  sintoma confuso, porque en la consola parece que todo salio bien.
  //
  //  ALTERNATIVA SIN ARCHIVO .env: usar la tarea "▶︎ Arrancar todo"
  //  (menu Terminal > Ejecutar tarea, o Cmd+Shift+B), que corre en la
  //  terminal y lee la clave del ~/.zshrc sola.
  // ============================================================
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "AppEscritorio",
      "request": "launch",
      "mainClass": "com.albaenlosandes.inventario.escritorio.AppEscritorio",
      "projectName": "gestor-inventario"
    },
    {
      "type": "java",
      "name": "Backend — Alba en los Andes",
      "request": "launch",
      "mainClass": "com.albaenlosandes.inventario.GestorInventarioApplication",
      "projectName": "gestor-inventario",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    }
  ]
}
